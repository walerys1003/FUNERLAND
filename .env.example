# ============================================================================
# Polskie Pogrzeby — Environment Variables
# Skopiuj jako .env.local i uzupełnij własnymi kluczami
# ============================================================================

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://polskie-pogrzeby.pl
NEXT_PUBLIC_SITE_NAME="Polskie Pogrzeby"

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Stripe Price IDs (6 planów subskrypcji)
STRIPE_PRICE_BASIC=price_xxxxx       # 199 zł/mc (legacy)
STRIPE_PRICE_STANDARD=price_xxxxx    # 149 zł/mc
STRIPE_PRICE_PRO=price_xxxxx         # 349 zł/mc
STRIPE_PRICE_PREMIUM=price_xxxxx     # 699 zł/mc
STRIPE_PRICE_ENTERPRISE=price_xxxxx  # 1499 zł/mc

# Pay-per-use
STRIPE_PRICE_LEAD_REVEAL=price_xxxxx     # 49 zł
STRIPE_PRICE_OBITUARY_PREMIUM=price_xxxxx # 49 zł

# ---- Przelewy24 (alternatywa dla PL) ----
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC_KEY=
P24_API_KEY=
P24_ENV=sandbox

# ---- Resend (email) ----
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=kontakt@polskie-pogrzeby.pl

# ---- SMSAPI.pl (SMS) ----
SMSAPI_TOKEN=
SMSAPI_SENDER=Pogrzeby

# ---- OpenAI (programmatic SEO content) ----
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4o-mini

# ---- Plausible (analytics) ----
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=polskie-pogrzeby.pl

# ---- Sentry (monitoring) ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Cron secret ----
CRON_SECRET=changeme-random-string

# ---- Admin ----
ADMIN_EMAIL=admin@polskie-pogrzeby.pl

# ---- Rate-limit (Upstash Redis) ----
# Bez tych zmiennych aplikacja używa in-memory rate-limit (działa per instancja).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Widget embed signing ----
# HMAC secret dla podpisanych tokenów widgetu (firmy Premium).
# Wygeneruj: `openssl rand -hex 32`
WIDGET_SIGNING_SECRET=changeme-32+chars-random-secret

# ---- Repository backend ----
# `true` = Supabase, `false` = in-memory (demo mode)
USE_SUPABASE=false

# ---- Sentry tuning ----
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_REPLAYS_ON_ERROR=1.0
NEXT_PUBLIC_BUILD_SHA=

# ---- Storage (Supabase Storage) ----
SUPABASE_STORAGE_BUCKET_AVATARS=avatars
SUPABASE_STORAGE_BUCKET_COMPANIES=companies
SUPABASE_STORAGE_BUCKET_OBITUARIES=obituaries
SUPABASE_STORAGE_BUCKET_DOCS=docs

# ---- CSP report endpoint (opcjonalny) ----
CSP_REPORT_URI=

# ---- E-mail FROM (override RESEND_FROM_EMAIL) ----
EMAIL_FROM_NAME="Polskie Pogrzeby"
EMAIL_REPLY_TO=kontakt@polskie-pogrzeby.pl

# ---- Brevo / Mailgun (fallback dla Resend, opcjonalnie) ----
BREVO_API_KEY=
